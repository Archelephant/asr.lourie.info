# Copy to .env and fill in. The .env file is untracked and never committed.
#
# Every value here can also be supplied as a plain environment variable, or
# as a mounted secret file through the matching <NAME>_FILE variable.

# --- ASR service ---------------------------------------------------------

# Endpoint of the upstream speech-to-text service.
ASR_URL=https://whisper.lourie.info/v1/audio/transcriptions

# Credential presented to the upstream speech service (HTTP Basic).
# This is the secret of that service — obtain it from whoever runs it.
# The file-backed form is ASR_UPSTREAM_KEY_FILE, which takes precedence.
ASR_UPSTREAM_KEY=

# API key that callers of THIS service present in the X-API-Key header.
# Generate your own:  openssl rand -hex 32
# Keep it different from ASR_UPSTREAM_KEY: this one is handed to your own
# clients, the upstream one is not.
# The file-backed form is ASR_API_KEY_FILE, which takes precedence.
ASR_API_KEY=

# --- TTS service (not implemented yet) ----------------------------------

TTS_URL=

# --- GigaChat ------------------------------------------------------------

# Base64-encoded GigaChat credentials. The file-backed form is
# GIGACHAT_CREDENTIALS_FILE.
GIGACHAT_CREDENTIALS=

# OAuth scope: GIGACHAT_API_PERS, GIGACHAT_API_B2B or GIGACHAT_API_CORP.
SCOPE=GIGACHAT_API_PERS

# Model used for text generation. Image attachments need a model that
# accepts images — GigaChat-2-Pro, GigaChat-Pro or GigaChat-2-Max.
GIGACHAT_MODEL=GigaChat-2

# Model used when the questionnaire carries an uploaded image. The default
# text model cannot read images ("Model does not support image").
GIGACHAT_VISION_MODEL=GigaChat-2-Pro

# Language and model used when an uploaded audio file is transcribed.
UPLOAD_ASR_LANGUAGE=ru-RU
UPLOAD_ASR_MODEL=large-v3-turbo

# --- TLS -----------------------------------------------------------------

# Path to a CA bundle, when the upstream service needs a custom root.
CA_BUNDLE_PATH=

# --- Logging --------------------------------------------------------------

# INFO or DEBUG.
LOG_LEVEL=INFO

# When enabled, the questionnaire content and the model's reply are written
# to the log. This service runs as a test instance and keeps them for later
# analysis, so it is on by default. Set it to false to keep the visitor's
# own words out of the log.
VERBOSE_LOGGING=true

# Certificates
russian_trusted_root_ca_pem.crt
russiantrustedca.crt
russiantrustedca.pem
sberbank_certs.pem
sberbank_root.pem

# Python cache
__pycache__/
*.pyc

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Virtual environment (if any)
venv/
env/
.env
.venv/
logs
secrets/

# OS metadata
.DS_Store
Thumbs.db

# Machine-specific agent tooling (shared commands and skills stay tracked)
.opencode/node_modules/
.opencode/package.json
.opencode/package-lock.json
.opencode/bun.lock
.openspec/**/node_modules/

# Local OpenSpec state
# NOTE: openspec/changes/*/.openspec.yaml is required metadata and MUST stay
# tracked — excluding it breaks archiving. Only per-machine state is ignored.
/.openspec.yaml
openspec/.cache/
openspec/*.local.yaml

# Local test artifacts
# NOTE: test.sh is tracked — it holds no secret, the key comes from the
# environment or an untracked .env.
test/*.wav
/test.wav
response*.wav

# Ignore Git version control files.
.git/
.gitignore

# Ignore Python virtual environments.
venv/
env/
ENV/

# Ignore environment variable files as they contain secrets.
.env
.env.*
test.sh

# Ignore Docker-related files.
.dockerignore
docker-compose.yml

# Ignore development-only files: they are not part of the running service.
requirements-dev.txt
pytest.ini
.pytest_cache/
tests/
test/
openspec/
.opencode/
.vscode/

# Ignore other development and temporary files.
__pycache__/
*.pyc
*.log
.DS_Store
logs/